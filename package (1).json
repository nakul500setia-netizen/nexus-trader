/**
 * agent/brain.js
 * The AI trading agent — uses Claude to reason over technical signals,
 * sentiment data, and custom strategy prompts to generate trade decisions
 */

import axios from 'axios';
import { logger } from '../utils/logger.js';

const ANTHROPIC_API = 'https://api.anthropic.com/v1/messages';

export class TradingBrain {
  constructor() {
    this.apiKey = process.env.ANTHROPIC_API_KEY;
    this.dailyTradeCount = 0;
    this.dailyPnL = 0;
    this.lastReset = new Date().toDateString();
    this.tradeHistory = [];
    this.fearGreedIndex = 50;
  }

  /** Reset daily counters at midnight */
  _checkDailyReset() {
    const today = new Date().toDateString();
    if (today !== this.lastReset) {
      this.dailyTradeCount = 0;
      this.dailyPnL = 0;
      this.lastReset = today;
    }
  }

  /** Fetch Fear & Greed Index */
  async fetchFearGreed() {
    try {
      const res = await axios.get('https://api.alternative.me/fng/?limit=1', { timeout: 5000 });
      const data = res.data?.data?.[0];
      if (data) {
        this.fearGreedIndex = parseInt(data.value);
        return { value: this.fearGreedIndex, label: data.value_classification, ts: data.timestamp };
      }
    } catch (err) {
      logger.warn('Fear & Greed fetch failed, using cached value:', err.message);
    }
    return { value: this.fearGreedIndex, label: 'Unknown', ts: Date.now() };
  }

  /**
   * Main analysis function — calls Claude with full market context
   * @param {Object} params
   * @param {string} params.symbol - e.g. "BTC/USDT"
   * @param {string} params.exchange - "binance" | "coinbase"
   * @param {Object} params.technicals - output from computeIndicators()
   * @param {Object} params.ticker - current price data
   * @param {Object} params.balance - current portfolio balance
   * @param {string} params.customStrategy - optional user-defined strategy prompt
   * @param {string} params.marketType - "spot" | "futures"
   * @param {number} params.leverage - futures leverage (1-20)
   * @returns {Object} Trade decision with reasoning
   */
  async analyze({ symbol, exchange, technicals, ticker, balance, customStrategy, marketType = 'spot', leverage = 1 }) {
    this._checkDailyReset();

    // Safety circuit breakers
    const maxTrades = parseInt(process.env.MAX_DAILY_TRADES || 20);
    const maxLoss = parseFloat(process.env.MAX_DAILY_LOSS_PCT || 3);

    if (this.dailyTradeCount >= maxTrades) {
      return this._safetyStop('Daily trade limit reached');
    }
    if (this.dailyPnL < -maxLoss) {
      return this._safetyStop(`Daily loss limit hit (${this.dailyPnL.toFixed(2)}%)`);
    }

    const fearGreed = await this.fetchFearGreed();
    const recentTrades = this.tradeHistory.slice(-5);

    const systemPrompt = this._buildSystemPrompt(customStrategy);
    const userPrompt = this._buildAnalysisPrompt({
      symbol, exchange, technicals, ticker, balance,
      fearGreed, recentTrades, marketType, leverage
    });

    try {
      const response = await this._callClaude(systemPrompt, userPrompt);
      const decision = this._parseDecision(response, technicals, ticker);

      logger.info(`AI Decision for ${symbol}: ${decision.action} (confidence: ${decision.confidence}%)`);

      // Record in history
      this.tradeHistory.push({
        ts: Date.now(),
        symbol,
        decision: decision.action,
        confidence: decision.confidence,
        reasoning: decision.reasoning,
      });

      return decision;
    } catch (err) {
      logger.error('AI analysis failed:', err.message);
      return this._fallbackDecision(technicals);
    }
  }

  /** Portfolio rebalancing analysis */
  async analyzePortfolio({ balance, prices, targetAllocation, totalValueUSD }) {
    const systemPrompt = `You are a crypto portfolio rebalancer. Analyze the current vs target allocation and recommend specific rebalancing trades. Respond only in JSON.`;

    const current = {};
    let total = 0;
    for (const [asset, info] of Object.entries(balance)) {
      const price = prices[asset + '/USDT'] || (asset === 'USDT' ? 1 : 0);
      const value = info.free * price;
      total += value;
      current[asset] = { amount: info.free, valueUSD: value };
    }
    for (const [asset, info] of Object.entries(current)) {
      info.pct = total > 0 ? +((info.valueUSD / total) * 100).toFixed(2) : 0;
    }

    const userPrompt = `
Portfolio total value: $${totalValueUSD?.toFixed(2) || total.toFixed(2)}

Current allocation:
${JSON.stringify(current, null, 2)}

Target allocation:
${JSON.stringify(targetAllocation, null, 2)}

Respond with JSON: { trades: [{ from, to, amount, reason }], summary: string }
Only recommend trades if drift > 2% from target.
`.trim();

    try {
      const response = await this._callClaude(systemPrompt, userPrompt, 600);
      return JSON.parse(response.replace(/```json|```/g, '').trim());
    } catch (err) {
      logger.error('Portfolio analysis failed:', err.message);
      return { trades: [], summary: 'Analysis unavailable — check API key' };
    }
  }

  // ─── Private helpers ──────────────────────────────────────

  _buildSystemPrompt(customStrategy) {
    return `You are NEXUS — an elite algorithmic crypto trading AI with expertise in technical analysis, market microstructure, and risk management.

Your role: Analyze market data and produce precise, actionable trade decisions.

Core principles:
- Capital preservation is paramount — when in doubt, stay out
- Only enter trades with clear edge: strong technicals + volume confirmation + favorable risk/reward
- Never chase momentum; look for confluence of multiple signals
- Adapt to market regime: trending markets favor trend-following, ranging markets favor mean-reversion
- Always assess the macro sentiment (Fear & Greed) as a filter

${customStrategy ? `\nUser's Custom Strategy:\n${customStrategy}\n\nApply this strategy as PRIMARY logic, supplemented by your standard analysis.` : ''}

Response format: Always respond with valid JSON only. No markdown, no commentary outside JSON.`;
  }

  _buildAnalysisPrompt({ symbol, exchange, technicals, ticker, balance, fearGreed, recentTrades, marketType, leverage }) {
    const { indicators, signals, patterns } = technicals;
    const usdtBal = balance?.USDT?.free || 0;
    const maxPositionPct = parseFloat(process.env.MAX_POSITION_SIZE_PCT || 5);
    const maxPositionUSD = usdtBal * maxPositionPct / 100;

    return `
Analyze ${symbol} on ${exchange} for a ${marketType} trade decision${leverage > 1 ? ` (${leverage}x leverage)` : ''}.

## Current Market
- Price: $${ticker?.last?.toFixed(4)}
- 24h Change: ${ticker?.percentage}%
- 24h High: $${ticker?.high?.toFixed(4)}
- 24h Low: $${ticker?.low?.toFixed(4)}
- Volume ratio: ${indicators.volume.ratio}x average

## Technical Indicators
- RSI(14): ${indicators.rsi.value} (prev: ${indicators.rsi.prev})
- MACD histogram: ${indicators.macd.histogram} | crossover: ${indicators.macd.crossover} | crossunder: ${indicators.macd.crossunder}
- Bollinger Band position: ${indicators.bollingerBands.position}% | squeeze: ${indicators.bollingerBands.squeeze}
- EMA stack: 9=${indicators.ema.ema9} | 20=${indicators.ema.ema20} | 50=${indicators.ema.ema50} | 200=${indicators.ema.ema200}
- ADX: ${indicators.adx.value} | +DI: ${indicators.adx.plusDI} | -DI: ${indicators.adx.minusDI}
- ATR: ${indicators.atr.value} (${indicators.atr.pct}% of price)
- StochRSI: K=${indicators.stochRSI.k} D=${indicators.stochRSI.d}
- VWAP: $${indicators.vwap}

## Composite Signal
- Direction: ${signals.signal}
- Bull score: ${signals.bullScore} | Bear score: ${signals.bearScore}
- Bullish probability: ${signals.bullPct}%
- Top reasons: ${signals.reasons.map(r => r.message).join('; ')}

## Price Action Patterns
${patterns.length > 0 ? patterns.map(p => `${p.name} (${p.type}, ${p.confidence}% confidence)`).join(', ') : 'No significant patterns'}

## Market Sentiment
- Fear & Greed Index: ${fearGreed.value}/100 (${fearGreed.label})

## Portfolio Context
- Available USDT: $${usdtBal.toFixed(2)}
- Max position size (${maxPositionPct}%): $${maxPositionUSD.toFixed(2)}

## Recent Agent Decisions (avoid over-trading same direction)
${recentTrades.map(t => `${new Date(t.ts).toISOString()}: ${t.decision} on ${t.symbol}`).join('\n') || 'None'}

## Required JSON Response Format:
{
  "action": "BUY" | "SELL" | "HOLD",
  "confidence": 0-100,
  "positionSizePct": 0-${maxPositionPct},
  "entryType": "market" | "limit",
  "limitPrice": null | number,
  "stopLoss": number,
  "takeProfit": number,
  "riskRewardRatio": number,
  "timeframe": "scalp" | "swing" | "position",
  "reasoning": "2-3 sentence explanation",
  "keyRisks": ["risk1", "risk2"],
  "invalidationLevel": number
}

If action is HOLD, set positionSizePct to 0. Be conservative — only recommend BUY/SELL when confidence >= 60.
`.trim();
  }

  async _callClaude(system, user, maxTokens = 1000) {
    if (!this.apiKey || this.apiKey === 'your_anthropic_api_key_here') {
      logger.warn('No Anthropic API key — returning mock analysis');
      return this._mockClaudeResponse();
    }

    const res = await axios.post(ANTHROPIC_API, {
      model: 'claude-sonnet-4-20250514',
      max_tokens: maxTokens,
      system,
      messages: [{ role: 'user', content: user }],
    }, {
      headers: {
        'x-api-key': this.apiKey,
        'anthropic-version': '2023-06-01',
        'content-type': 'application/json',
      },
      timeout: 30000,
    });

    return res.data.content[0].text;
  }

  _parseDecision(responseText, technicals, ticker) {
    try {
      const json = JSON.parse(responseText.replace(/```json|```/g, '').trim());
      return {
        action: json.action || 'HOLD',
        confidence: json.confidence || 50,
        positionSizePct: json.positionSizePct || 0,
        entryType: json.entryType || 'market',
        limitPrice: json.limitPrice,
        stopLoss: json.stopLoss,
        takeProfit: json.takeProfit,
        riskRewardRatio: json.riskRewardRatio,
        timeframe: json.timeframe || 'swing',
        reasoning: json.reasoning || '',
        keyRisks: json.keyRisks || [],
        invalidationLevel: json.invalidationLevel,
        source: 'claude',
        timestamp: Date.now(),
      };
    } catch (err) {
      logger.error('Failed to parse Claude response:', err.message);
      return this._fallbackDecision(technicals);
    }
  }

  _fallbackDecision(technicals) {
    const signal = technicals?.signals?.signal || 'NEUTRAL';
    const confidence = technicals?.signals?.bullPct || 50;
    const price = technicals?.price || 0;
    return {
      action: signal.includes('BUY') ? 'BUY' : signal.includes('SELL') ? 'SELL' : 'HOLD',
      confidence,
      positionSizePct: 1,
      entryType: 'market',
      stopLoss: price * 0.97,
      takeProfit: price * 1.05,
      riskRewardRatio: 1.67,
      timeframe: 'swing',
      reasoning: 'Fallback decision based on technical signals only (AI unavailable)',
      keyRisks: ['AI analysis unavailable'],
      source: 'fallback',
      timestamp: Date.now(),
    };
  }

  _safetyStop(reason) {
    return {
      action: 'HOLD',
      confidence: 100,
      positionSizePct: 0,
      reasoning: `Safety stop: ${reason}`,
      keyRisks: [reason],
      source: 'safety',
      timestamp: Date.now(),
    };
  }

  _mockClaudeResponse() {
    const actions = ['BUY', 'SELL', 'HOLD'];
    const action = actions[Math.floor(Math.random() * actions.length)];
    const price = 94800;
    return JSON.stringify({
      action,
      confidence: Math.floor(Math.random() * 30 + 55),
      positionSizePct: action === 'HOLD' ? 0 : 2,
      entryType: 'limit',
      limitPrice: price * 0.998,
      stopLoss: price * 0.97,
      takeProfit: price * 1.06,
      riskRewardRatio: 2.0,
      timeframe: 'swing',
      reasoning: `Mock analysis: ${action === 'BUY' ? 'RSI oversold with MACD bullish crossover and volume confirmation' : action === 'SELL' ? 'Price near upper Bollinger Band, bearish divergence on RSI' : 'Mixed signals — waiting for clearer setup'}. Risk managed with stop at -3%.`,
      keyRisks: ['Mock mode — real API key required', 'Market volatility'],
      invalidationLevel: price * (action === 'BUY' ? 0.965 : 1.035),
      source: 'mock',
    });
  }
}

export const tradingBrain = new TradingBrain();
